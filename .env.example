# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gym_trainer

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini

# --- WhatsApp platform (outbound send) ---
# Used by the dinner-reminder job to push messages.
PLATFORM_SEND_URL=https://your-platform.com/api/send-message
PLATFORM_API_KEY=agnt_your_key_here

# --- Reminders ---
# Run the in-process scheduler (true) or trigger /tasks/dinner-reminders externally (false)
ENABLE_SCHEDULER=false
DINNER_REMINDER_HOUR=18
DINNER_REMINDER_MINUTE=0
TIMEZONE=Asia/Karachi
